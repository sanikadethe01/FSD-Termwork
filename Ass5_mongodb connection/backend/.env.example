# MongoDB Atlas connection string for deployment or local testing
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolioDB?retryWrites=true&w=majority

# Render will provide the PORT automatically, but local fallback is 5000
PORT=5000

# Frontend URL for CORS when deployed to Vercel
FRONTEND_URL=https://your-frontend-url.vercel.app
